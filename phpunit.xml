<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>

        <!--
            O MESMO FUSO DA PRODUCAO.

            Sem isto o teste roda em UTC enquanto o app roda em Brasilia, e ai o teste deixa de
            responder a pergunta que ele existe para responder: nao e mais o mesmo relogio.
            Regra de horario passava as 20h no teste e falhava as 20h no ar.
        -->
        <env name="APP_TIMEZONE" value="America/Sao_Paulo"/>

        <!--
            Vídeo desligado no teste, sempre.

            Sem isto, a suite passa a se comportar de um jeito no servidor que tem credencial
            de video e de outro na maquina que nao tem — e a diferenca aparece longe daqui,
            num teste de diagnostico que conta problemas. Quem precisa de video no teste liga
            explicitamente, como o VideoTest faz.
        -->
        <env name="LIVEKIT_URL" value=""/>
        <env name="LIVEKIT_API_URL" value=""/>
        <env name="LIVEKIT_API_KEY" value=""/>
        <env name="LIVEKIT_API_SECRET" value=""/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="onchat_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="REDIS_PREFIX" value="onchat_test_"/>
    </php>
</phpunit>
